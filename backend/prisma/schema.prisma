generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(120)
  email     String    @unique @db.VarChar(160)
  password  String    @db.VarChar(255)
  isActive  Boolean   @default(true)
  roleId    Int
  role      Role      @relation(fields: [roleId], references: [id])
  products  Product[] @relation("ProductCreator")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([roleId])
  @@map("users")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(140)
  sku         String   @unique @db.VarChar(80)
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdById Int?
  createdBy   User?    @relation("ProductCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
  @@map("products")
}
